<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= TIPOGRAFIA ================= -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="TextBlock.titulo">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>

    <Style Selector="TextBlock.subtitulo">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.etiqueta">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextoTerciario}" />
    </Style>

    <Style Selector="TextBlock.tenue">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextoSecundario}" />
    </Style>

    <Style Selector="TextBlock.micro">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextoTerciario}" />
    </Style>

    <Style Selector="TextBlock.marca">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.marcaParte">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushPrimario}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ================= TARJETAS ================= -->
    <Style Selector="Border.tarjeta">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <!-- ================= BOTONES ================= -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushFondoTenue}" />
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <Style Selector="Button.primario">
        <Setter Property="Background" Value="{StaticResource BrushPrimario}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.primario:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushPrimarioOscuro}" />
    </Style>

    <Style Selector="Button.primario:pressed">
        <Setter Property="Background" Value="{StaticResource BrushPrimarioOscuro}" />
    </Style>

    <Style Selector="Button.primario:focus">
        <Setter Property="Background" Value="{StaticResource BrushPrimario}" />
    </Style>

    <Style Selector="Button.peligro">
        <Setter Property="Background" Value="{StaticResource BrushErrorSuave}" />
        <Setter Property="Foreground" Value="{StaticResource BrushError}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushErrorBorde}" />
    </Style>

    <Style Selector="Button.peligro:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushErrorBorde}" />
    </Style>

    <Style Selector="Button.fantasma">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextoSecundario}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="Button.fantasma:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushFondoTenue}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}" />
    </Style>

    <!-- ================= NAVEGACION LATERAL ================= -->
    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextoSecundario}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="Button.nav:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushFondoTenue}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}" />
    </Style>

    <!-- El estado activo se aplica con la clase "activo" enlazada desde el ViewModel. -->
    <Style Selector="Button.nav.activo">
        <Setter Property="Background" Value="{StaticResource BrushPrimarioSuave}" />
        <Setter Property="Foreground" Value="{StaticResource BrushPrimario}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- ================= CAMPOS ================= -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimario}" />
    </Style>

    <!-- ================= TARJETAS SELECCIONABLES (opciones del quiz) ================= -->
    <Style Selector="Border.opcion">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Border.opcion:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource BrushTextoTerciario}" />
    </Style>

    <!-- ================= TARJETA CLICABLE (carpetas, tests) ================= -->
    <Style Selector="Button.tarjeta">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.tarjeta:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimarioBorde}" />
    </Style>

    <!-- ================= TARJETA CLICABLE (opciones del quiz) ================= -->
    <Style Selector="Button.opcion">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.opcion:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource BrushTextoTerciario}" />
    </Style>

    <Style Selector="Button.opcion.seleccionada">
        <Setter Property="Background" Value="{StaticResource BrushPrimarioSuave}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimario}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Button.opcion.acertada">
        <Setter Property="Background" Value="{StaticResource BrushExitoSuave}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushExitoBorde}" />
    </Style>

    <Style Selector="Button.opcion.fallada">
        <Setter Property="Background" Value="{StaticResource BrushErrorSuave}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushErrorBorde}" />
    </Style>

    <!-- ================= ICONOS ================= -->
    <Style Selector="PathIcon">
        <Setter Property="Foreground" Value="{StaticResource BrushTextoSecundario}" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Muestra de color seleccionada -->
    <Style Selector="Button.seleccionado">
        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimario}" />
        <Setter Property="BorderThickness" Value="3" />
    </Style>

</Styles>

