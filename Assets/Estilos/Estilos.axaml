<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= TIPOGRAFIA ================= -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="TextBlock.titulo">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>

    <Style Selector="TextBlock.subtitulo">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.etiqueta">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextoTerciario}" />
    </Style>

    <Style Selector="TextBlock.tenue">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextoSecundario}" />
    </Style>

    <Style Selector="TextBlock.micro">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextoTerciario}" />
    </Style>

    <Style Selector="TextBlock.marca">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.marcaParte">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushPrimario}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ================= TARJETAS ================= -->
    <Style Selector="Border.tarjeta">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <!-- ================= BOTONES ================= -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushFondoTenue}" />
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <Style Selector="Button.primario">
        <Setter Property="Background" Value="{StaticResource BrushPrimario}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.primario:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushPrimarioOscuro}" />
    </Style>

    <Style Selector="Button.primario:pressed">
        <Setter Property="Background" Value="{StaticResource BrushPrimarioOscuro}" />
    </Style>

    <Style Selector="Button.primario:focus">
        <Setter Property="Background" Value="{StaticResource BrushPrimario}" />
    </Style>

    <Style Selector="Button.peligro">
        <Setter Property="Background" Value="{StaticResource BrushErrorSuave}" />
        <Setter Property="Foreground" Value="{StaticResource BrushError}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushErrorBorde}" />
    </Style>

    <Style Selector="Button.peligro:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushErrorBorde}" />
    </Style>

    <Style Selector="Button.fantasma">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextoSecundario}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="Button.fantasma:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushFondoTenue}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}" />
    </Style>

    <!-- ================= NAVEGACION LATERAL ================= -->
    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextoSecundario}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="Button.nav:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushFondoTenue}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}" />
    </Style>

    <!-- El estado activo se aplica con la clase "activo" enlazada desde el ViewModel. -->
    <Style Selector="Button.nav.activo">
        <Setter Property="Background" Value="{StaticResource BrushPrimarioSuave}" />
        <Setter Property="Foreground" Value="{StaticResource BrushPrimario}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- ================= CAMPOS ================= -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimario}" />
    </Style>

    <!-- ================= TARJETAS SELECCIONABLES (opciones del quiz) ================= -->
    <Style Selector="Border.opcion">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Border.opcion:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource BrushTextoTerciario}" />
    </Style>

    <!-- ================= TARJETA CLICABLE (carpetas, tests) ================= -->
    <Style Selector="Button.tarjeta">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.tarjeta:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimarioBorde}" />
    </Style>

    <!-- ================= TARJETA CLICABLE (opciones del quiz) ================= -->
    <Style Selector="Button.opcion">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.opcion:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource BrushTextoTerciario}" />
    </Style>

    <Style Selector="Button.opcion.seleccionada">
        <Setter Property="Background" Value="{StaticResource BrushPrimarioSuave}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimario}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Button.opcion.acertada">
        <Setter Property="Background" Value="{StaticResource BrushExitoSuave}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushExitoBorde}" />
    </Style>

    <Style Selector="Button.opcion.fallada">
        <Setter Property="Background" Value="{StaticResource BrushErrorSuave}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushErrorBorde}" />
    </Style>

    <!-- ================= ICONOS ================= -->
    <Style Selector="PathIcon">
        <Setter Property="Foreground" Value="{StaticResource BrushTextoSecundario}" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Muestra de color seleccionada -->
    <Style Selector="Button.seleccionado">
        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimario}" />
        <Setter Property="BorderThickness" Value="3" />
    </Style>

    <!-- Aviso flotante (sustituye a la barra superior para los mensajes) -->
    <Style Selector="Border.toast">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BoxShadow" Value="0 6 22 0 #14000000" />
    </Style>

    <!-- ================= BOTÓN IMPORTAR (con gradiente y animación) ================= -->

    <Style Selector="Button.importar">
        <Setter Property="Background" Value="{StaticResource BrushPrimarioGradiente}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="RenderTransform" Value="ScaleTransform(1)" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.importar:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushPrimarioGradienteHover}" />
        <Setter Property="RenderTransform" Value="ScaleTransform(1.04)" />
    </Style>

    <Style Selector="Button.importar:pressed">
        <Setter Property="Background" Value="{StaticResource BrushPrimarioGradientePressed}" />
        <Setter Property="RenderTransform" Value="ScaleTransform(0.97)" />
    </Style>

    <!-- ================= TARJETA CARPETA (con pestaña) ================= -->

    <Style Selector="Border.carpeta">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="BoxShadow" Value="0 3 12 0 #0F172A12" />
        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.carpeta:hover">
        <Setter Property="BoxShadow" Value="0 12 28 0 #1F5C54E5" />
    </Style>

    <!-- Casilla de selección: se define aquí porque el CheckBox del tema Fluent no se ve. -->
    <Style Selector="ToggleButton.casilla">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="ToggleButton.casilla:checked">
        <Setter Property="Background" Value="{StaticResource BrushPrimario}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimario}" />
    </Style>

    <Style Selector="ToggleButton.casilla PathIcon">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="ToggleButton.casilla:checked PathIcon">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Acción destructiva (eliminar): el botón principal se pinta en rojo. -->
    <Style Selector="Button.primario.destructivo">
        <Setter Property="Background" Value="{StaticResource BrushError}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.primario.destructivo /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushError}" />
    </Style>

    <Style Selector="Button.primario.destructivo:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushError}" />
    </Style>

    <!-- Radio de "respuesta correcta": se define aquí para que use el violeta de la app. -->
    <Style Selector="Button.radio">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.radio Ellipse.punto">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Fill" Value="Transparent" />
    </Style>

    <Style Selector="Button.radio.correcta Ellipse.punto">
        <Setter Property="Fill" Value="{StaticResource BrushPrimario}" />
    </Style>

    <Style Selector="Button.radio.correcta">
        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimario}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

</Styles>

