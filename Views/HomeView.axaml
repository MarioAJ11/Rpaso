<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Rpaso.ViewModels"
             x:Class="Rpaso.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <ScrollViewer>
        <StackPanel Margin="32,26,32,32" Spacing="22"
                    HorizontalAlignment="Stretch">

            <!-- ==================== CARPETAS ==================== -->
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="Tus carpetas de estudio" FontSize="17" FontWeight="Bold" />
                        <TextBlock Classes="micro"
                                   Text="Clic izquierdo para abrir una carpeta · clic derecho para editarla o eliminarla"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding AbrirModalCarpetaCommand}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M 1,4 L 6,4 L 7.5,5.5 L 14,5.5 L 14,13 L 1,13 Z M 11,7 L 12,7 L 12,9 L 14,9 L 14,10 L 12,10 L 12,12 L 11,12 L 11,10 L 9,10 L 9,9 L 11,9 Z"
                                      Foreground="{StaticResource BrushPrimario}" Width="16" Height="16" />
                            <TextBlock Text="Nueva carpeta" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding Carpetas}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CarpetaViewModel">
                            <Button Classes="iconoCarpeta"
                                    Width="152" Height="140" Margin="4"
                                    Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).AbrirCarpetaCommand}"
                                    CommandParameter="{Binding}"
                                    ContextRequested="OnFolderContextRequested">
                                <ToolTip.Tip>
                                    <Border Background="#F1F3F5" BorderBrush="#D1D5DB"
                                            BorderThickness="1" CornerRadius="8" Padding="10,7">
                                        <TextBlock Text="{Binding Descripcion}" Foreground="#111827"
                                                   TextWrapping="Wrap" MaxWidth="280" />
                                    </Border>
                                </ToolTip.Tip>
                                <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <PathIcon Data="M 1,5 C 1,3.9 1.9,3 3,3 L 7,3 C 7.5,3 7.8,3.2 8.2,3.6 L 10,5 L 17,5 C 18.1,5 19,5.9 19,7 L 19,16 C 19,17.1 18.1,18 17,18 L 3,18 C 1.9,18 1,17.1 1,16 Z"
                                              Foreground="{Binding Icono}" Width="84" Height="72" />
                                    <TextBlock Text="{Binding Nombre}" TextAlignment="Center"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxHeight="34" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
