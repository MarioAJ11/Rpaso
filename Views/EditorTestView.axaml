<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Rpaso.ViewModels"
             x:Class="Rpaso.Views.EditorTestView"
             x:DataType="vm:EditorTestViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- ==================== CABECERA ==================== -->
        <Border Grid.Row="0" Background="{StaticResource BrushSuperficie}"
                BorderBrush="{StaticResource BrushBorde}" BorderThickness="0,0,0,1" Padding="28,14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="EDITANDO EXAMEN" Classes="etiqueta" Foreground="{StaticResource BrushPrimario}" />
                    <TextBox Text="{Binding Titulo}" FontSize="18" FontWeight="Bold"
                             Padding="8,4" Background="Transparent" BorderThickness="0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Command="{Binding AñadirPreguntaCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Data="M 8,1 L 10,1 L 10,7 L 16,7 L 16,9 L 10,9 L 10,15 L 8,15 L 8,9 L 2,9 L 2,7 L 8,7 Z"
                                      Foreground="{StaticResource BrushPrimario}" Width="15" Height="15" />
                            <TextBlock Text="Añadir pregunta" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelarCommand}" Content="Cancelar" />
                    <Button Classes="primario" Command="{Binding GuardarCommand}" Content="Guardar cambios" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== PREGUNTAS ==================== -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="28,22" Spacing="16" MaxWidth="980" HorizontalAlignment="Left">

                <ItemsControl ItemsSource="{Binding Preguntas}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PreguntaEditorViewModel">
                            <Border Classes="panel" Padding="20" Margin="0,0,0,14">
                                <StackPanel Spacing="14">

                                    <!-- Enunciado -->
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="ENUNCIADO" Classes="etiqueta" />
                                        <TextBox Text="{Binding Enunciado}" AcceptsReturn="True" MinHeight="70"
                                                 TextWrapping="Wrap" VerticalContentAlignment="Top" />
                                    </StackPanel>

                                    <!-- Opciones -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="OPCIONES" Classes="etiqueta" />

                                        <ItemsControl ItemsSource="{Binding Opciones}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:OpcionEditorViewModel">
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,6">
                                                        <Button Grid.Column="0" Classes="radio"
                                                                Classes.correcta="{Binding EsCorrecta}"
                                                                Command="{Binding $parent[ItemsControl].((vm:PreguntaEditorViewModel)DataContext).MarcarOpcionComoCorrectaCommand}"
                                                                CommandParameter="{Binding}"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,10,0"
                                                                ToolTip.Tip="Marcar como la respuesta correcta">
                                                            <Ellipse Classes="punto" />
                                                        </Button>

                                                        <Border Grid.Column="1" Width="28" Height="28" CornerRadius="8"
                                                Background="{StaticResource BrushFondoTenue}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Letra}" FontWeight="Bold" FontSize="12"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>

                                                        <TextBox Grid.Column="2" Text="{Binding Texto}" Margin="10,0,10,0" />

                                                        <Button Grid.Column="3" Classes="fantasma" Padding="8,4"
                                                        Command="{Binding $parent[ItemsControl].((vm:PreguntaEditorViewModel)DataContext).EliminarOpcionCommand}"
                                                        CommandParameter="{Binding}">
                                                            <PathIcon Data="M 5,5 L 7,5 L 10,8 L 13,5 L 15,5 L 11,10 L 15,15 L 13,15 L 10,12 L 7,15 L 5,15 L 9,10 Z"
                                              Foreground="{StaticResource BrushError}" Width="14" Height="14" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Classes="fantasma" HorizontalAlignment="Left" Padding="8,4"
                                                Command="{Binding AñadirOpcionCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="M 8,1 L 10,1 L 10,7 L 16,7 L 16,9 L 10,9 L 10,15 L 8,15 L 8,9 L 2,9 L 2,7 L 8,7 Z"
                                                          Foreground="{StaticResource BrushPrimario}" Width="13" Height="13" />
                                                <TextBlock Text="Añadir opción" FontSize="12" Foreground="{StaticResource BrushPrimario}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <Border Height="1" Background="{StaticResource BrushBordeSuave}" />

                                    <Button Classes="fantasma" HorizontalAlignment="Left" Padding="8,4"
                                            Command="{Binding $parent[ItemsControl].((vm:EditorTestViewModel)DataContext).EliminarPreguntaCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="M 5,5 L 7,5 L 10,8 L 13,5 L 15,5 L 11,10 L 15,15 L 13,15 L 10,12 L 7,15 L 5,15 L 9,10 Z"
                                                      Foreground="{StaticResource BrushError}" Width="14" Height="14" />
                                            <TextBlock Text="Eliminar pregunta" FontSize="12" Foreground="{StaticResource BrushError}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="tenue" HorizontalAlignment="Left"
                           IsVisible="{Binding !Preguntas.Count}"
                           Text="Este examen no tiene preguntas. Usa «Añadir pregunta» para empezar." />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
