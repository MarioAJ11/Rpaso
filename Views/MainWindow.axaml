<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Rpaso.ViewModels"
        xmlns:views="using:Rpaso.Views"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="Rpaso.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Repaso"
        Icon="/Assets/repaso.ico"
        Width="1320" Height="840"
        MinWidth="1060" MinHeight="680"
        Background="{StaticResource BrushFondo}"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="264,*">

        <!-- ==================== BARRA LATERAL ==================== -->
        <Border Grid.Column="0"
                Background="{StaticResource BrushSuperficie}"
                BorderBrush="{StaticResource BrushBorde}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,Auto,*">

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,22,24,0" Spacing="10">
                    <Border Width="36" Height="36" CornerRadius="10"
                            Background="{StaticResource BrushPrimario}" ClipToBounds="True">
                        <Image Source="/Assets/repaso.ico" Stretch="UniformToFill" Width="36" Height="36" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="1">
                        <TextBlock Text="repaso" Classes="marca" />
                        <TextBlock Text="." Classes="marcaParte" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="MENÚ" Classes="etiqueta" Margin="24,28,24,0" />

                <StackPanel Grid.Row="2" Margin="12,10,12,0" Spacing="4">
                    <Button Classes="nav"
                            Classes.activo="{Binding EsVistaInicio}"
                            Command="{Binding IrAInicioCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="M 2,9 L 10,2 L 18,9 L 16,9 L 16,17 L 11.5,17 L 11.5,12 L 8.5,12 L 8.5,17 L 4,17 L 4,9 Z" />
                            <TextBlock Text="Inicio" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="nav" Command="{Binding IrAInicioCommand}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="M 2,5 L 8,5 L 10,7 L 18,7 L 18,16 L 2,16 Z" />
                                <TextBlock Text="Mis carpetas" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource BrushFondoTenue}" CornerRadius="8" Padding="7,1">
                                <TextBlock Text="{Binding Carpetas.Count}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextoSecundario}" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ==================== CONTENIDO ==================== -->
        <Grid Grid.Column="1">

            <!-- Vista activa: el ViewLocator convierte el ViewModel en su control -->
            <ContentControl Content="{Binding VistaActual}" />

            <!-- Capa de carga -->
            <Border Background="#77FFFFFF" IsVisible="{Binding Ocupado}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                    <ProgressBar IsIndeterminate="True" Width="240" />
                    <TextBlock Text="Procesando…" Classes="tenue" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Aviso flotante: sustituye a la barra superior para los mensajes -->
            <Border Classes="toast"
                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,26,26"
                    IsVisible="{Binding Estado, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource BrushExito}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Estado}" FontSize="13" MaxWidth="520"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== MODAL: INFORME DE IMPORTACIÓN ==================== -->
        <Border Grid.ColumnSpan="2" Background="#66000000" IsVisible="{Binding MostrarInformeImportacion}">
            <views:InformeImportacionView DataContext="{Binding InformeImportacion}" />
        </Border>

        <!-- ==================== MODAL GENÉRICO (renombrar / confirmar / crear) ==================== -->
        <Border Grid.ColumnSpan="2" Background="#66000000" IsVisible="{Binding ModalVisible}">
            <Border Background="{StaticResource BrushSuperficie}"
                    BorderBrush="{StaticResource BrushBorde}" BorderThickness="1"
                    CornerRadius="20"
                    Width="440"
                    Padding="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="18">
                    <TextBlock Text="{Binding ModalTitulo}" Classes="subtitulo" />
                    <TextBlock Text="{Binding ModalDescripcion}" Classes="tenue" TextWrapping="Wrap" />

                    <StackPanel Spacing="7" IsVisible="{Binding ModalMostrarEntrada}">
                        <TextBox Text="{Binding ModalValor}" PlaceholderText="Escribe aquí" />
                        <TextBox Text="{Binding ModalDescripcionCarpeta}" PlaceholderText="Descripción (opcional)"
                                 IsVisible="{Binding ModalMostrarColores}" />
                    </StackPanel>

                    <StackPanel Spacing="9" IsVisible="{Binding ModalMostrarColores}">
                        <TextBlock Text="COLOR IDENTIFICATIVO" Classes="etiqueta" />
                        <ItemsControl ItemsSource="{Binding Colores}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ColorCarpetaViewModel">
                                    <Button Width="46" Height="36" Margin="0,0,8,8"
                                            Background="{Binding Fondo}" BorderBrush="{Binding Borde}"
                                            BorderThickness="2" CornerRadius="10"
                                            Classes.seleccionado="{Binding Seleccionado}"
                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SeleccionarColorModalCommand}"
                                            CommandParameter="{Binding Id}"
                                            ToolTip.Tip="{Binding Nombre}">
                                        <Ellipse Width="13" Height="13" Fill="{Binding Icono}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="Cancelar" Command="{Binding CerrarModalCommand}" />
                        <Button Classes="primario" Classes.destructivo="{Binding ModalEsPeligroso}"
                                Command="{Binding AceptarModalCommand}">
                            <TextBlock Text="{Binding ModalTextoBoton}" Foreground="White" FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>
