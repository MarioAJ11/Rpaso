<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Rpaso.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Rpaso.Views.FolderView"
             x:DataType="vm:FolderViewModel">

    <ScrollViewer>
        <StackPanel Margin="48,32,48,40" Spacing="28"
                    HorizontalAlignment="Stretch">

            <!-- ==================== CABECERA ==================== -->
            <Border Classes="panel" Padding="26" HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                        <Button Classes="fantasma" Command="{Binding VolverCommand}" Padding="8" VerticalAlignment="Top">
                            <PathIcon Data="M 13,3 L 6,10 L 13,17 Z" Width="18" Height="18" />
                        </Button>
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding Nombre}" Classes="subtitulo" />
                                <Border Background="{StaticResource BrushPrimarioSuave}" CornerRadius="8" Padding="8,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="CARPETA" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource BrushPrimario}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Classes="peligro"
                                Command="{Binding PracticarCarpetaFalladasCommand}"
                                CommandParameter="{Binding Carpeta}"
                                IsEnabled="{Binding HayFalladas}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="M 16,5 A 7,7 0 1 1 11,3 L 11,0 L 18,4 L 11,8 L 11,5 A 4,4 0 1 0 14,9 Z"
                                          Foreground="{StaticResource BrushError}" Width="15" Height="15" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding TotalFalladas, StringFormat='Practicar solo falladas ({0})'}" />
                            </StackPanel>
                        </Button>

                        <Button Classes="primario"
                                Command="{Binding PracticarCarpetaCommand}"
                                CommandParameter="{Binding Carpeta}"
                                IsEnabled="{Binding HayTests}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="M 10,2 L 18,10 L 10,18 L 2,10 Z" Foreground="White" Width="15" Height="15" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding TotalPreguntas, StringFormat='Practicar todos juntos ({0})'}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== LISTA DE TESTS ==================== -->
            <StackPanel Spacing="18">
                <Border Classes="panel" Padding="16">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="Exámenes en esta carpeta"
                                   FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center" IsVisible="{Binding ModoSeleccion}">
                            <Button Classes="fantasma" Padding="8,4" Command="{Binding SeleccionarTodoCommand}">
                                <TextBlock Text="Seleccionar todo / ninguno" FontSize="12" VerticalAlignment="Center" />
                            </Button>
                            <TextBlock Text="{Binding TextoSeleccion}" Classes="micro" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid Grid.Column="2" IsVisible="{Binding HayTests}">
                            <Button Classes="primario" Command="{Binding IniciarSeleccionCommand}"
                                    IsVisible="{Binding !ModoSeleccion}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="M 10,2 L 18,10 L 10,18 L 2,10 Z"
                                              Foreground="White" Width="14" Height="14" />
                                    <TextBlock Text="Empezar selección" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        IsVisible="{Binding ModoSeleccion}">
                                <Button Classes="cancelarSeleccion" Command="{Binding CancelarSeleccionCommand}"
                                        Content="Cancelar" />
                                <Button Classes="primario" Command="{Binding PracticarSeleccionCommand}"
                                        IsEnabled="{Binding HaySeleccion}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="M 10,2 L 18,10 L 10,18 L 2,10 Z"
                                                  Foreground="White" Width="14" Height="14" />
                                        <TextBlock Text="Empezar práctica" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Button Grid.Column="3" Classes="fantasma" Command="{Binding ImportarPdfCommand}"
                                VerticalAlignment="Center" Width="38" Height="36" Padding="0"
                                ToolTip.Tip="Añadir PDF a esta carpeta">
                            <PathIcon Data="M 3,2 L 11,2 L 15,6 L 15,10 L 13,10 L 13,7 L 10,7 L 10,4 L 5,4 L 5,16 L 12,16 L 12,18 L 3,18 Z M 16,11 L 18,11 L 18,13 L 20,13 L 20,15 L 18,15 L 18,17 L 16,17 L 16,15 L 14,15 L 14,13 L 16,13 Z"
                                      Foreground="{StaticResource BrushPrimario}" Width="20" Height="20" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Estado vacío -->
                <Border Classes="panel" Padding="48" IsVisible="{Binding !HayTests}">
                    <StackPanel Spacing="7" HorizontalAlignment="Center">
                        <PathIcon Data="M 4,2 L 11,2 L 15,6 L 15,18 L 4,18 Z"
                                  Width="36" Height="36" Foreground="{StaticResource BrushTextoTerciario}" />
                        <TextBlock Text="Esta carpeta no tiene exámenes aún" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Classes="micro" MaxWidth="380" TextWrapping="Wrap" HorizontalAlignment="Center"
                                   Text="Importa un PDF de tipo test para empezar a estudiar las preguntas de esta materia." />
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="ListaTests" ItemsSource="{Binding Tests}"
                              HorizontalAlignment="Stretch" SizeChanged="OnTestListSizeChanged">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="20" LineSpacing="20" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TestViewModel">
                            <Border Classes="panel" HorizontalAlignment="Stretch" Padding="22"
                                    ContextRequested="OnTestContextRequested">
                                <Grid>
                                    <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <ToggleButton Grid.Column="0" Classes="casilla"
                                                      IsChecked="{Binding Seleccionada, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                                      IsVisible="{Binding $parent[ItemsControl].((vm:FolderViewModel)DataContext).ModoSeleccion}"
                                                      ToolTip.Tip="Seleccionar para una práctica combinada">
                                            <PathIcon Data="M 3,8 L 6,11 L 13,4" Width="13" Height="13" />
                                        </ToggleButton>
                                        <Border Grid.Column="1" Width="34" Height="34" CornerRadius="9"
                                                Background="{StaticResource BrushErrorSuave}" HorizontalAlignment="Left">
                                            <PathIcon Data="M 4,2 L 11,2 L 15,6 L 15,18 L 4,18 Z"
                                                      Foreground="{StaticResource BrushError}" Width="17" Height="17" />
                                        </Border>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource BrushBordeSuave}" />

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Titulo}" FontWeight="Bold" FontSize="15"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Titulo}"
                                                       DoubleTapped="OnTestTitleDoubleTapped" Cursor="Hand" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Classes="micro"
                                                           Text="{Binding TotalPreguntas, StringFormat='{}{0} preguntas'}" />
                                                <TextBlock Classes="micro" Text="{Binding Fecha}" />
                                                <TextBlock Classes="micro" Foreground="{StaticResource BrushError}"
                                                           IsVisible="{Binding HayFalladas}"
                                                           Text="{Binding TotalFalladas, StringFormat='{}{0} falladas'}" />
                                                <Border Background="{StaticResource BrushExitoSuave}" CornerRadius="6"
                                                        Padding="7,2" IsVisible="{Binding Completado}">
                                                    <TextBlock Text="COMPLETADO" FontSize="9" FontWeight="Bold"
                                                               Foreground="{StaticResource BrushExito}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="1" Classes="primario"
                                                VerticalAlignment="Bottom"
                                                Command="{Binding $parent[ItemsControl].((vm:FolderViewModel)DataContext).PracticarTestCommand}"
                                                CommandParameter="{Binding}"
                                                Width="42" Height="36" Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                ToolTip.Tip="Practicar">
                                            <Path Data="M 1,9 L 17,9 M 10,2 L 17,9 L 10,16"
                                                  Stroke="White" StrokeThickness="1.8"
                                                  StrokeLineCap="Round" StrokeJoin="Round"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Width="18" Height="18" />
                                        </Button>
                                    </Grid>

                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
